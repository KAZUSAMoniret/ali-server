[Unit]
Description=Backup life blog database and photos
After=postgresql.service

[Service]
Type=oneshot
User=blog
Group=www-data
WorkingDirectory=/srv/life-blog/app
EnvironmentFile=/etc/life-blog.env
ExecStart=/srv/life-blog/venv/bin/python scripts/backup.py backup --output /var/backups/life-blog
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/life-blog
