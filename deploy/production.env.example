DJANGO_ENV=production
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=blog.example.com
SITE_URL=https://blog.example.com
DATABASE_URL=postgresql://blog:URL_ENCODED_PASSWORD@127.0.0.1:5432/blog
MEDIA_ROOT=/var/lib/life-blog/media
STATIC_ROOT=/srv/life-blog/static
USE_X_ACCEL=1
SECURE_SSL_REDIRECT=1
